# ==============================================================================
# RESTOCKPILOT ENVIRONMENT CONFIGURATION
# Standard PayPal Developer Integration (https://developer.paypal.com/get-started)
# ==============================================================================

# 1. PayPal Sandbox REST App Credentials
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
# Select your REST API app or create a new one under Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# PayPal REST API Base URL
# Sandbox: https://api-m.sandbox.paypal.com (Default)
# Production: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# 2. PayPal Sandbox Webhook ID
# Create a webhook endpoint in your Sandbox app pointing to:
# https://<your-domain>/api/webhooks/paypal
# Subscribed event: PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=

# 3. Application Base URL (for experience_context return_url & cancel_url)
APP_URL=http://localhost:3000

# 4. Agent & Catalog Providers (Optional for demo mode; required for live LLM / catalog)
OPENAI_API_KEY=
CHANNEL3_API_KEY=

